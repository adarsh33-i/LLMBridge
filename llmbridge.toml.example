# LLMBridge routing configuration.
#
# Durable Generations (inspecting/forking past requests) is controlled by the
# environment, not this file:
#   LLMBRIDGE_TRACK_GENERATIONS=1            # record every generation (default on)
#   LLMBRIDGE_LEDGER_PATH=.llmbridge/generations
#   LLMBRIDGE_TRACK_INTERRUPTED=1            # save interrupted work for resumption
#   LLMBRIDGE_LEDGER_MAX_RECORDS=10          # records retained in the ledger
# Only the newest records are kept; interrupted work is one of them.
#
# Self-healing streams (stitch a broken stream back together on a fallback):
#   LLMBRIDGE_SELF_HEAL=1                    # default on; needs fallbacks below
#
# Queue generations on quota errors instead of failing them:
#   LLMBRIDGE_QUEUE_ON_QUOTA=1               # opt-in (default off)
#   LLMBRIDGE_QUEUE_RETRY_SECONDS=5          # base delay without an upstream Retry-After
#   LLMBRIDGE_QUEUE_MAX_ATTEMPTS=5           # dispatch attempts before failing
#
# Inspect the results with:
#   llmbridge tree <id>      # fork lineage
#   llmbridge diff <idA> <idB>
#   llmbridge replay <id> | --all   # regression-check outputs against the ledger

[models.nemotron-local]
base_url = "http://127.0.0.1:11434/v1"
model = "nemotron"

[models.qwen-local]
base_url = "http://127.0.0.1:11434/v1"
model = "qwen3:8b"

[models.hosted-free]
base_url = "https://your-openai-compatible-provider.example/v1"
model = "provider/model-id"
api_key_env = "HOSTED_MODEL_API_KEY"

[models.claude-sonnet-4-5]
base_url = "https://integrate.api.nvidia.com/v1"
model = "nvidia/nemotron-3-ultra-550b-a55b"
api_key_env = "NVIDIA_API_KEY"
# Try these aliases in order if this route fails (quota, rate limit, outage).
fallbacks = ["claude-haiku-4-5"]
# Forward Anthropic cache_control breakpoints instead of stripping them.
# cache_control = "passthrough"

[models.claude-haiku-4-5]
base_url = "https://integrate.api.nvidia.com/v1"
model = "nvidia/nemotron-3.5-lightning-30b-a3b"
api_key_env = "NVIDIA_API_KEY"
